# Public site URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Standalone Nitro listener. Keep it private behind Nginx in production.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# maplibre-dev is for local development only; production target is amap.
NUXT_PUBLIC_MAP_PROVIDER=maplibre-dev
NUXT_PUBLIC_AMAP_KEY=
NUXT_PUBLIC_AMAP_SECURITY_CODE=

# Server-only values. Do not expose these through NUXT_PUBLIC_*.
NUXT_DATABASE_PATH=./data/yeu.sqlite
NUXT_ADMIN_SESSION_SECRET=

# Used by `pnpm db:init`. Plaintext is accepted only as process input and is
# immediately converted to a scrypt hash. Prefer the hash variable in production.
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=
NUXT_ADMIN_PASSWORD_HASH=

# Admin session lifetime in hours (1-168). Defaults to 12.
NUXT_ADMIN_SESSION_TTL_HOURS=12

# Feedback privacy retention. Run `pnpm feedback:cleanup` daily from cron.
NUXT_FEEDBACK_IP_RETENTION_DAYS=30
NUXT_FEEDBACK_CONTACT_RETENTION_DAYS=90
NUXT_FEEDBACK_RECORD_RETENTION_DAYS=730

# Optional comma-separated extra origins allowed to call write APIs.
# The configured public site URL is always allowed.
NUXT_ALLOWED_ORIGINS=

# Enable only after Nginx forwarding headers and trusted proxy scope are verified.
NUXT_TRUST_PROXY=false
