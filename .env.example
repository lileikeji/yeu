# Public site URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Standalone Nitro listener. Keep it private behind Nginx in production.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# maplibre-dev is for local development only; production target is amap.
NUXT_PUBLIC_MAP_PROVIDER=maplibre-dev
NUXT_PUBLIC_AMAP_KEY=
NUXT_PUBLIC_AMAP_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=

# Public map/search overlay for authorized amap owner draft places.
# Defaults to true. Set false to return an empty list from the public API.
NUXT_PUBLIC_ENABLE_AMAP_OWNER_DRAFTS=true

# Server-only values. Do not expose these through NUXT_PUBLIC_*.
NUXT_DATABASE_PATH=./data/yeu.sqlite
NUXT_ADMIN_SESSION_SECRET=

# Persistent public media directory. Production should point to shared/uploads.
NUXT_UPLOAD_DIR=./storage/uploads

# Used by `pnpm db:init`. Plaintext is accepted only as process input and is
# immediately converted to a scrypt hash. Prefer the hash variable in production.
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=
NUXT_ADMIN_PASSWORD_HASH=

# Admin session lifetime in hours (1-168). Defaults to 12.
# Production HTTPS uses __Host-yeu_admin_session / __Host-yeu_admin_csrf cookies.
NUXT_ADMIN_SESSION_TTL_HOURS=12

# Idle timeout for admin sessions in hours (1-168). Defaults to 4.
# Sessions expire earlier if lastSeenAt is older than this window.
NUXT_ADMIN_SESSION_IDLE_HOURS=4

# Feedback privacy retention. Run `pnpm feedback:cleanup` daily from cron.
NUXT_FEEDBACK_IP_RETENTION_DAYS=30
NUXT_FEEDBACK_CONTACT_RETENTION_DAYS=90
NUXT_FEEDBACK_RECORD_RETENTION_DAYS=730

# Optional comma-separated extra origins allowed to call write APIs.
# The configured public site URL is always allowed.
NUXT_ALLOWED_ORIGINS=

# Enable only after Nginx forwarding headers and trusted proxy scope are verified.
NUXT_TRUST_PROXY=false

# When NUXT_TRUST_PROXY=true, only honor X-Forwarded-For from trusted TCP peers.
# loopback (default): same-host Nginx to NITRO_HOST=127.0.0.1
# private: also accept RFC1918 peers (docker sidecars). Spoofed XFF from other peers is ignored.
NUXT_TRUST_PROXY_PEERS=loopback

# Structured request logs are enabled by default in production. Set false only
# when an equivalent upstream access log is intentionally used and monitored.
NUXT_REQUEST_LOGGING=

# Production monitor. Run `pnpm ops:monitor` every minute from cron or the
# hosting control panel. The webhook receives only issue codes and aggregate
# metrics; HTTPS is required. Outbound webhook also re-checks DNS (no private/metadata). Keep the state path in a persistent shared dir.
NUXT_MONITOR_HEALTH_URL=http://127.0.0.1:3000/api/health
NUXT_MONITOR_BACKUP_DIR=./data/backups
NUXT_MONITOR_REQUEST_LOG_PATH=
NUXT_MONITOR_STATE_PATH=./data/production-monitor-state.json
NUXT_MONITOR_WEBHOOK_URL=
NUXT_MONITOR_LABEL=yeu-production
NUXT_MONITOR_TIMEOUT_MS=8000
NUXT_MONITOR_MAX_BACKUP_AGE_HOURS=26
NUXT_MONITOR_MIN_DISK_FREE_GIB=5
NUXT_MONITOR_MIN_DISK_FREE_PERCENT=15
NUXT_MONITOR_MAX_WAL_MIB=256
NUXT_MONITOR_MIN_MEMORY_FREE_PERCENT=10
NUXT_MONITOR_MAX_LOAD_PER_CPU=2
NUXT_MONITOR_LOG_WINDOW_MINUTES=15
NUXT_MONITOR_MAX_SERVER_ERRORS=0
NUXT_MONITOR_MAX_LOGIN_FAILURES=4
NUXT_MONITOR_MAX_RATE_LIMITED=0
NUXT_MONITOR_REMINDER_HOURS=6

# Amap Web Service key for server-side or offline scripts only.
# Do NOT put this in NUXT_PUBLIC_* or ship it to the browser.
AMAP_WEB_SERVICE_KEY=
