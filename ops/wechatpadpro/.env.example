# This file documents required variables. Production values live outside Git at
# /www/wwwroot/yeu/shared/wechatpadpro/.env with mode 0640.
WECHATPADPRO_IMAGE=wechatpadpro/wechatpadpro@sha256:436685d7d7f9ac690718caba8b8f95ace92ffe6edd2ccfa002459f364ca1282e
WECHATPADPRO_MYSQL_IMAGE=mysql:8.0@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
WECHATPADPRO_REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
WECHATPADPRO_ENV_FILE=/www/wwwroot/yeu/shared/wechatpadpro/.env

MYSQL_ROOT_PASSWORD=replace-with-random-secret
MYSQL_DATABASE=yeu_wechatpadpro
MYSQL_USER=yeu_wechatpadpro
MYSQL_PASSWORD=replace-with-random-secret
REDIS_PASSWORD=replace-with-random-secret
ADMIN_KEY=replace-with-random-secret

# Generated by POST /admin/GenAuthKey1 after the stack starts.
WECHATPADPRO_AUTH_KEY=
WECHATPADPRO_BASE_URL=http://127.0.0.1:1238
WECHATPADPRO_WEBHOOK_SECRET=replace-with-random-secret
WECHATPADPRO_WEBHOOK_URL=http://172.30.28.1:3022/webhook/wechatpadpro

YEU_WECHATPADPRO_RELAY_HOST=172.30.28.1
YEU_WECHATPADPRO_RELAY_PORT=3022
YEU_WECHATPADPRO_TARGET_URL=http://127.0.0.1:3000/api/integrations/bots/wechat
NUXT_WECHAT_BOT_WEBHOOK_SECRET=replace-with-random-secret
NUXT_WECHAT_BOT_SEND_URL=http://172.30.28.1:3022/api/send
NUXT_WECHAT_BOT_ID=
NUXT_WECHAT_BOT_NAME=

# Deny by default. Add exact room IDs only after login and user approval.
NUXT_WECHAT_BOT_ALLOWED_ROOM_IDS=
