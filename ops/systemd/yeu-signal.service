[Unit]
Description=YEU campus signal index rebuild and daily report
After=network-online.target yeu.service
Wants=network-online.target

[Service]
Type=oneshot
User=yeu
Group=yeu
# 发布包只有 nitro 输出，脚本和 tsx 放在 /opt/yeu-signal（与 yeu-knowledge-crawl.service 同一套运行环境）。
WorkingDirectory=/opt/yeu-signal
EnvironmentFile=/www/wwwroot/yeu/shared/.env
Environment=NUXT_DATABASE_PATH=/www/wwwroot/yeu/shared/data/yeu.sqlite
Environment=NODE_ENV=production
ExecStart=/opt/node-v22.18.0/bin/node /opt/yeu-signal/node_modules/tsx/dist/cli.mjs scripts/signal-build.ts --days 400 --report both
TimeoutStartSec=20min
MemoryMax=512M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/www/wwwroot/yeu/shared/data /www/wwwroot/yeu/shared/logs /opt/yeu-signal
