[Unit]
Description=YEU campus signal index rebuild and daily report
After=network-online.target yeu.service
Wants=network-online.target

[Service]
Type=oneshot
User=yeu
Group=yeu
# 发布包只有 nitro 输出，脚本和 tsx 在 git 检出目录里，和 yeu-knowledge-crawl.service 一致。
WorkingDirectory=/www/wwwroot/yeu/repo
Environment=NUXT_DATABASE_PATH=/www/wwwroot/yeu/shared/data/yeu.sqlite
Environment=NODE_ENV=production
ExecStart=/opt/node-v22.18.0/bin/node /www/wwwroot/yeu/repo/node_modules/tsx/dist/cli.mjs scripts/signal-build.ts --days 45 --report both
TimeoutStartSec=20min
MemoryMax=512M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/www/wwwroot/yeu/shared/data /www/wwwroot/yeu/shared/logs
