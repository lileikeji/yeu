---
import { CLUB_META } from '../data/club';

const nav = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/departments/', label: '部门', key: 'departments' },
  { href: '/activities/', label: '活动', key: 'activities' },
  { href: '/projects/', label: '项目', key: 'projects' },
  { href: '/news/', label: '动态', key: 'news' },
  { href: '/mirrors/', label: '镜像', key: 'mirrors' },
  { href: '/git/', label: 'Git ↗', externalOrigin: true, key: 'git' },
  { href: '/about/', label: '关于', key: 'about' },
  { href: '/member/', label: '会员登录 / 名录激活', mobileOnly: true, key: 'member' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header" data-open="false">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img
        class="brand-logo"
        src="/images/yeuca-logo.jpg"
        alt="仰恩大学计算机协会徽标"
        width="34"
        height="34"
      />
      <span>
        <span class="brand-title">{CLUB_META.name}</span>
        <span class="brand-sub">{CLUB_META.enName} · {CLUB_META.campus}</span>
      </span>
    </a>

    <nav class="main-nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            class={`nav-link${item.externalOrigin ? ' js-git-link' : ''}${item.mobileOnly ? ' nav-link-mobile-only' : ''}`}
            data-nav-key={item.key}
            href={item.href}
            aria-current={!item.externalOrigin && isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <a
        class="nav-member"
        href="/member/"
        id="header-member-btn"
        data-nav-key="member"
        aria-current={isActive('/member/') ? 'page' : undefined}
      >
        <span class="member-status-dot" aria-hidden="true"></span>
        <span id="header-member-text">会员登录</span>
      </a>
      <button
        class="theme-toggle"
        type="button"
        id="theme-toggle"
        data-theme-toggle
        aria-label="配色：跟随系统，点击切到浅色"
        title="配色：跟随系统，点击切到浅色"
      >
        <span class="theme-toggle-icon" data-theme-icon="system" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="12" r="7.4"></circle>
            <path d="M12 4.6a7.4 7.4 0 0 0 0 14.8z" fill="currentColor" stroke="none"></path>
          </svg>
        </span>
        <span class="theme-toggle-icon" data-theme-icon="light" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.1"></circle>
            <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
          </svg>
        </span>
        <span class="theme-toggle-icon" data-theme-icon="dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
            <path d="M20.4 14.6A8.6 8.6 0 1 1 9.4 3.6a6.9 6.9 0 0 0 11 11z"></path>
          </svg>
        </span>
      </button>
      <a class="nav-cta" href="/join/" aria-current={isActive('/join/') ? 'page' : undefined}>加入我们</a>
      <button
        class="mobile-menu-btn"
        type="button"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-btn
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        <span data-menu-label>菜单</span>
      </button>
    </div>
  </div>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const progressBar = document.getElementById('scroll-progress');

  const syncHeaderScroll = () => {
    const y = window.scrollY || 0;
    header?.classList.toggle('is-scrolled', y > 12);
    if (progressBar) {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const ratio = Math.min(1, Math.max(0, y / max));
      progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
    }
  };
  syncHeaderScroll();
  window.addEventListener('scroll', syncHeaderScroll, { passive: true });
  window.addEventListener('resize', syncHeaderScroll, { passive: true });

  if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
    document.querySelectorAll<HTMLAnchorElement>('.js-git-link').forEach((link) => {
      link.href = 'https://yeuca.huiliyill.cn/git/';
      link.target = '_blank';
      link.rel = 'noreferrer';
    });
  }

  if (header && btn) {
    const labelEl = btn.querySelector('[data-menu-label]');
    const setOpen = (open: boolean) => {
      header.dataset.open = open ? 'true' : 'false';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (labelEl) labelEl.textContent = open ? '收起' : '菜单';
    };
    const isOpen = () => header.dataset.open === 'true';
    btn.addEventListener('click', () => setOpen(!isOpen()));
    header.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      const target = event.target;
      if (target instanceof Node && !header.contains(target)) setOpen(false);
    });
  }
</script>
