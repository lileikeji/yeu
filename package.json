{
  "name": "yeu-freshman-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial freshman guide for Yang-En University",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node scripts/guard-build-host.mjs && nuxt build && tsx scripts/copy-sqlite-vec-binary.ts && tsx scripts/copy-client-manifest.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm bundle:budget && pnpm pwa:build:test",
    "bundle:budget": "tsx scripts/check-client-bundle-budget.ts",
    "amap:coordinates": "tsx scripts/import-amap-coordinates.ts",
    "amap:coordinates:test": "tsx --test scripts/import-amap-coordinates.test.ts",
    "amap:drafts": "tsx scripts/import-amap-drafts.ts",
    "amap:drafts:test": "tsx --test scripts/import-amap-drafts.test.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:admin:test": "tsx --test scripts/admin-bootstrap.test.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:generate": "drizzle-kit generate --config scripts/drizzle.config.ts",
    "db:hash-password": "tsx scripts/hash-password.ts",
    "db:init": "tsx scripts/db-init.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:test": "tsx --test scripts/database-upgrade.test.ts",
    "db:invariants:test": "tsx --test scripts/publishing-invariants.test.ts",
    "db:seed:catalog": "tsx scripts/seed-public-catalog.ts",
    "db:seed:catalog:test": "tsx --test scripts/seed-public-catalog.test.ts scripts/sync-public-catalog.test.ts",
    "db:seed:assistant": "tsx scripts/seed-assistant-knowledge.ts",
    "db:seed:amap-ratings": "tsx scripts/seed-amap-ratings.ts",
    "db:seed:procedures": "tsx scripts/seed-procedures.ts",
    "db:seed:manifest": "node scripts/seed-manifest.mjs write",
    "db:seed:manifest:verify": "node scripts/seed-manifest.mjs verify",
    "db:sync:catalog": "tsx scripts/sync-public-catalog.ts",
    "data:verify": "tsx scripts/verify-live-data-parity.ts",
    "data:verify:local": "tsx scripts/verify-live-data-parity.ts --database .data/codex-map-content-20260713.sqlite",
    "data:verify:test": "tsx --test scripts/verify-live-data-parity.test.ts",
    "feedback:cleanup": "tsx scripts/cleanup-feedback.ts",
    "faculty:collect": "tsx scripts/collect-official-faculty.ts",
    "knowledge:crawl:official": "tsx scripts/crawl-official-knowledge.ts",
    "knowledge:compile": "tsx scripts/compile-official-knowledge.ts",
    "knowledge:import:handbook": "tsx scripts/import-freshman-handbook.ts",
    "knowledge:import:welcome": "tsx scripts/import-welcome-public-knowledge.ts",
    "security:cleanup": "tsx scripts/cleanup-sensitive-data.ts",
    "env:test": "tsx --test scripts/load-env.test.ts",
    "e2e": "pnpm build && pnpm e2e:run",
    "e2e:install": "playwright install chromium",
    "e2e:install:ci": "playwright install --with-deps chromium",
    "e2e:prepare": "tsx scripts/prepare-e2e-database.ts",
    "e2e:run": "pnpm e2e:prepare && playwright test",
    "check:e2e": "pnpm check && pnpm e2e:run",
    "map:boundary:sync": "tsx scripts/sync-osm-campus-boundary.ts",
    "map:context:audit": "tsx scripts/audit-osm-campus-context.ts",
    "map:geocode:audit": "tsx scripts/audit-amap-geocoding.ts",
    "map:owner:sync": "tsx scripts/sync-amap-owner-coordinates.ts",
    "map:owner:classifications": "tsx scripts/sync-amap-owner-classifications.ts",
    "map:dorm-labels": "tsx scripts/sync-dorm-comfort-labels.ts",
    "map:wia:extract": "tsx scripts/extract-amap-sparse-list.ts",
    "map:data:test": "tsx --test scripts/sync-osm-campus-boundary.test.ts scripts/campus-map-reference.test.ts scripts/coordinate-observations.test.ts",
    "map:plan:check": "tsx scripts/check-official-campus-plan.ts",
    "map:readiness": "tsx scripts/map-readiness.ts",
    "map:readiness:test": "tsx --test scripts/map-readiness.test.ts",
    "map:sources:sync": "tsx scripts/sync-place-source-links.ts",
    "ops:monitor": "tsx scripts/monitor-production.ts",
    "procedures:test": "tsx --test scripts/procedures.test.ts scripts/seed-procedures.test.ts",
    "pwa:build:test": "tsx --test tests/pwa-build.test.ts",
    "search:test": "tsx --test scripts/public-search.test.ts scripts/public-catalog.test.ts",
    "ykt-bus:test": "tsx --test scripts/ykt-bus-protocol.test.ts",
    "sources:check": "tsx scripts/check-source-links.ts",
    "sources:discover": "tsx scripts/discover-official-sources.ts",
    "test": "tsx --test scripts/*.test.ts",
    "ui:utils:test": "tsx --test scripts/safe-navigation.test.ts",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "memory:cleanup": "tsx scripts/cleanup-session-memory.ts",
    "embeddings:rebuild": "tsx scripts/rebuild-embeddings.ts",
    "caches:cleanup": "tsx scripts/cleanup-assistant-caches.ts",
    "memory:consolidate": "tsx scripts/consolidate-session-memory.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "qa:sweep": "tsx scripts/assistant-qa-sweep.ts",
    "miniapp:install": "pnpm --dir miniapp install --ignore-workspace",
    "miniapp:dev": "pnpm --dir miniapp dev",
    "miniapp:build": "pnpm --dir miniapp build",
    "miniapp:typecheck": "pnpm --dir miniapp typecheck",
    "signal:build": "tsx scripts/signal-build.ts"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/ui": "^4.9.0",
    "@tiptap/y-tiptap": "3.0.7",
    "@vite-pwa/nuxt": "^1.1.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "1.1.2",
    "d3-force": "3.0.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.3",
    "h3": "1.15.11",
    "maplibre-gl": "^5.24.0",
    "nodemailer": "^10.4.0",
    "nuxt": "^4.5.2",
    "pdfjs-dist": "5.4.624",
    "pinyin-pro": "^3.28.2",
    "qrcode": "^1.5.4",
    "sqlite-vec": "^0.1.9",
    "supercluster": "^9.0.0",
    "tailwindcss": "^4.3.1",
    "three": "0.185.1",
    "word-extractor": "1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "3.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supercluster": "^7.1.3",
    "@types/three": "0.185.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vue-router": "5.1.0",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@10.28.1",
  "optionalDependencies": {
    "@huggingface/transformers": "^3.5.1",
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  }
}
