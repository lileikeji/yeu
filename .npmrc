# Project npm/pnpm settings.
# Vulnerability gate for CI/deps is OSV scanner (osv-scanner.toml), not only
# `pnpm audit` - registry mirrors can break audit metadata (e.g. npmmirror).
# Do not force a registry here; use your user/global .npmrc for npmmirror/npmjs.

# Fail install when engine ranges are clearly incompatible.
engine-strict=true
